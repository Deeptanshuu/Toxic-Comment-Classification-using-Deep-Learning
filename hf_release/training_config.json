{
  "model_name": "xlm-roberta-large",
  "max_length": 512,
  "hidden_size": 1024,
  "num_attention_heads": 16,
  "model_dropout": 0.0,
  "freeze_layers": 0,
  "freeze_embeddings": true,
  "cache_dir": "cached_dataset",
  "checkpoint_dir": "weights/toxic_classifier_xlmr_v2",
  "label_columns": [
    "toxic",
    "severe_toxic",
    "obscene",
    "threat",
    "insult",
    "identity_hate"
  ],
  "batch_size": 64,
  "grad_accum_steps": 2,
  "epochs": 6,
  "lr": 2e-05,
  "num_cycles": 2,
  "weight_decay": 2e-07,
  "max_grad_norm": 1.0,
  "warmup_ratio": 0.1,
  "label_smoothing": 0.01,
  "min_lr_ratio": 0.01,
  "activation_checkpointing": true,
  "mixed_precision": "fp16",
  "_num_workers": 8,
  "gc_frequency": 500,
  "tensor_float_32": false,
  "train_file": "dataset/split/train.csv",
  "val_file": "dataset/split/val.csv",
  "test_file": "dataset/split/test.csv",
  "dynamic_padding": true,
  "pad_to_multiple_of": 8,
  "use_class_weights": true,
  "use_warmup": true,
  "data_parallel": true,
  "eval_batch_size": 256,
  "eval_every_epoch": true,
  "lang_weights": "weights/language_class_weights.json",
  "disable_lang_conditioning": false,
  "class_weights_file": "weights/language_class_weights.json",
  "device": "cuda"
}